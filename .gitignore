# Intelyi monorepo ignore rules
#
# Keep source, migrations, package manifests, lockfiles, and config templates in git.
# Keep generated dependencies, build output, caches, credentials, local databases,
# and raw/private datasets out of git.

# =========================
# OS / editor noise
# =========================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# =========================
# Secrets / local env
# =========================
.env
.env.*
!.env.example
!.env.template
!.env.sample

# =========================
# Local dependency installs
# =========================
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/

# =========================
# Python generated files
# =========================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# =========================
# Next.js / TypeScript output
# =========================
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
next-env.d.ts

# =========================
# Package manager caches / logs
# =========================
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Framework / deployment output
# =========================
.vercel/
**/.vercel/

# =========================
# Prisma / generated clients
# =========================
src/generated/prisma/
**/src/generated/prisma/
generated/
**/generated/

# =========================
# Local databases and runtime artifacts
# =========================
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
tmp/
**/tmp/
temp/
**/temp/

# =========================
# Data and uploaded artifacts
# =========================
data/
**/data/
uploads/
**/uploads/
exports/
**/exports/

# =========================
# Codex / local agent state
# =========================
.codex
.codex/
**/.codex
**/.codex/
