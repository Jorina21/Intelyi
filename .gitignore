# Intelyi monorepo ignore rules
#
# Keep source, migrations, package manifests, lockfiles, and config templates in git.
# Keep generated dependencies, build output, caches, credentials, local databases,
# and raw/private datasets out of git.

# =========================
# OS / editor noise
# =========================
.DS_Store
Thumbs.db
Desktop.ini
.Spotlight-V100/
.Trashes/
*.swp
*.swo
*~
.idea/
.vscode/

# =========================
# Secrets / local env
# =========================
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.crt

# =========================
# Local dependency installs
# =========================
node_modules/
**/node_modules/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
__pypackages__/

# =========================
# Python generated files
# =========================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.py,cover
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.pyre/
.tox/
.nox/
.ipynb_checkpoints/
.python-version
pip-wheel-metadata/
.coverage
.coverage.*
coverage.xml
htmlcov/

# =========================
# Next.js / TypeScript output
# =========================
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
.turbo/
.parcel-cache/
.cache/
.eslintcache

# =========================
# Package manager caches / logs
# =========================
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# =========================
# Framework / deployment output
# =========================
.vercel/
**/.vercel/

# =========================
# Prisma / generated clients
# =========================
src/generated/prisma/
**/src/generated/prisma/

# =========================
# Local databases and runtime artifacts
# =========================
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.db-journal
*.pid
*.pid.lock
*.seed
*.stackdump
tmp/
**/tmp/
temp/
**/temp/

# =========================
# Data and uploaded artifacts
# =========================
data/
data/amazon_dataset/
uploads/
exports/

# =========================
# Test output
# =========================
coverage/
**/coverage/
test-results/
playwright-report/

# =========================
# Codex / local agent state
# =========================
.codex
.codex/
**/.codex
**/.codex/
